Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"===", 
    RowBox[{
     RowBox[{"Import", " ", "a", " ", "BehaviorSpace", " ", "Table"}], "-", 
     RowBox[{"format", " ", "CSV"}]}], "==="}], "*)"}], 
  RowBox[{
   RowBox[{"ImportBehaviorSpace", "[", 
    RowBox[{
    "csvPath_String", ",", "paramName_String", ",", "metricName_String"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "data", ",", "headerRow", ",", "columns", ",", "rows", ",", "records"}],
       "}"}], ",", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"Import", "[", 
        RowBox[{"csvPath", ",", "\"\<CSV\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Find", " ", "the", " ", "column", " ", "header", " ", "row", " ", 
        "by", " ", "locating", " ", "\"\<[run number]\>\""}], "*)"}], 
      RowBox[{"headerRow", "=", 
       RowBox[{
        RowBox[{"FirstPosition", "[", 
         RowBox[{
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], 
          ",", "\"\<[run number]\>\""}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"columns", "=", 
       RowBox[{"data", "[", 
        RowBox[{"[", "headerRow", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"rows", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"data", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"headerRow", "+", "1"}], ";;"}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], "==", 
            RowBox[{"Length", "[", "columns", "]"}]}], "&&", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "=!=", "\"\<\>\""}]}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"records", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"AssociationThread", "[", 
          RowBox[{"columns", ",", "#"}], "]"}], "&"}], "/@", "rows"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Pull", " ", "just", " ", "the", " ", "parameter", " ", "and", " ", 
        "metric", " ", "of", " ", "interest"}], "*)"}], 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "paramName", "]"}], "&"}], "/@", "records"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "metricName", "]"}], "&"}], "/@", "records"}]}], 
        "}"}], "]"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.98697794811755*^9, 3.986977948119178*^9}, {
  3.986978079628085*^9, 3.986978085644638*^9}},
 CellLabel->
  "In[396]:=",ExpressionUUID->"b2724ab0-7294-428c-8ec6-69cea92847b2"],

