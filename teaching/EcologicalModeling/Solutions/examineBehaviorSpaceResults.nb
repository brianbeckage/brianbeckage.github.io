Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"===", 
    RowBox[{"Use", " ", "it"}], "==="}], "*)"}], "\n", "\[IndentingNewLine]", 
  
  RowBox[{
   RowBox[{"points", "=", 
    RowBox[{"ImportBehaviorSpace", "[", 
     RowBox[{"\"\<Beckage_Netlogo7_butterfliesObs_sol q to maximize \
neighbors-table.csv\>\"", ",", "\"\<q\>\"", ",", "\"\<mean-Neighbors\>\""}], 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.98697794811755*^9, 3.986977948119178*^9}, 
   3.986978079628085*^9, {3.986978263650742*^9, 3.9869782672698803`*^9}, {
   3.98697838008092*^9, 3.98697842325443*^9}},
 CellLabel->
  "In[423]:=",ExpressionUUID->"bed55a39-f0ef-491d-afff-aa7ae832edc6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "If", " ", "you", " ", "have", " ", "multiple", " ", "reps", " ", "per", " ",
      "q", " ", "value"}], ",", 
    RowBox[{"average", " ", "them"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"meanByQ", "=", 
     RowBox[{"SortBy", "[", 
      RowBox[{
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#1", ",", 
            RowBox[{"Mean", "[", "#2", "]"}]}], "}"}], "&"}], ",", 
         RowBox[{"GroupBy", "[", 
          RowBox[{"points", ",", 
           RowBox[{"First", "->", "Last"}]}], "]"}]}], "]"}], ",", "First"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"===", 
     RowBox[{"Plot", " ", "the", " ", "curve"}], "==="}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{"meanByQ", ",", 
     RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<q\>\"", ",", "\"\<mean-Neighbors\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", "\"\<BehaviorSpace sweep: q vs mean-Neighbors\>\""}], 
     ",", 
     RowBox[{"GridLines", "->", "Automatic"}], ",", 
     RowBox[{"ImageSize", "->", "500"}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"===", 
     RowBox[{"Best", " ", 
      RowBox[{"q", ":", 
       RowBox[{
        RowBox[{
        "simple", " ", "argmax", " ", "over", " ", "the", " ", "sampled", " ",
          "points"}], "==="}]}]}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bestPoint", "=", 
     RowBox[{
      RowBox[{"MaximalBy", "[", 
       RowBox[{"meanByQ", ",", "Last"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Best sampled q = \>\"", ",", 
     RowBox[{"bestPoint", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<  (mean-Neighbors = \>\"", ",", 
     RowBox[{"bestPoint", "[", 
      RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<)\>\""}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"===", 
     RowBox[{"Best", " ", 
      RowBox[{"q", ":", 
       RowBox[{
        RowBox[{"interpolated", " ", "peak", " ", 
         RowBox[{"(", 
          RowBox[{"smoother", " ", "estimate"}], ")"}]}], "==="}]}]}]}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"interp", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"meanByQ", ",", 
       RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"peakValue", ",", "peakSol"}], "}"}], "=", 
     RowBox[{"NMaximize", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"interp", "[", "q", "]"}], ",", 
         RowBox[{
          RowBox[{"meanByQ", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "<=", "q", "<=", 
          RowBox[{"meanByQ", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}]}], "}"}], ",", 
       "q"}], "]"}]}], ";"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Interpolated peak: q = \>\"", ",", 
     RowBox[{"q", "/.", " ", "peakSol"}], 
     ",", "\"\<  (mean-Neighbors \[TildeTilde] \>\"", ",", "peakValue", 
     ",", "\"\<)\>\""}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.98697794811755*^9, 3.986977948119178*^9}, 
   3.986978079628085*^9, {3.986978263650742*^9, 3.9869782672698803`*^9}, {
   3.98697838008092*^9, 3.9869784119957113`*^9}},
 CellLabel->
  "In[424]:=",ExpressionUUID->"33637186-97b7-48e0-a807-a2636ea90819"],

