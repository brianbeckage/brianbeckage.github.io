				<units>Moose/Moose*Years</units>
			</aux>
			<stock name="Wolves">
				<eqn>Initial_Wolves</eqn>
				<inflow>wolves_being_born</inflow>
				<outflow>wolves_starving</outflow>
				<non_negative/>
				<units>Wolves</units>
			</stock>
			<flow name="wolves being born">
				<eqn>c*p*Wolves*Moose</eqn>
				<non_negative/>
				<units>Wolves/Years</units>
			</flow>
			<flow name="wolves starving">
				<eqn>Wolves*s</eqn>
				<non_negative/>
				<units>Wolves/Years</units>
			</flow>
			<aux name="p">
				<eqn>1.334</eqn>
				<format precision="0.01"/>
				<range min="0" max="2"/>
				<units>Moose/Moose*Wolves*Years</units>
			</aux>
			<aux name="s">
				<eqn>1</eqn>
				<format precision="0.01"/>
				<range min="0" max="2"/>
				<units>Wolves / Wolves*Years</units>
			</aux>
			<aux name="Initial Moose">
				<eqn>1</eqn>
				<units>Moose</units>
			</aux>
			<aux name="Initial Wolves">
				<eqn>1</eqn>
				<units>Wolves</units>
			</aux>
			<aux name="c">
				<eqn>0.75</eqn>
				<format precision="0.01"/>
				<range min="0" max="2"/>
				<units>Wolves/Moose</units>
			</aux>
		</variables>
